#!/bin/bash

# Runs linting before allowing commits
# CI passes --all to format every file instead of just staged ones

set -e

echo "Running clang-format..."

if [ "$1" = "--all" ]; then
  FILES=$(git ls-files -- 'src/*.c' 'include/*.h')
else
  FILES=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.c' 'include/*.h')
fi

if [ -z "$FILES" ]; then
  echo "No C/C++ files to format."
  exit 0
fi

echo "$FILES" | xargs pipx run 'clang-format==18.*' -i
echo "$FILES" | xargs git add

echo "Pre-commit formatting complete."
